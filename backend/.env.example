# Copy this file to .env and fill in your own values.

# --- Server ---
PORT=8081
TZ=Asia/Colombo

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=garage_booking_db

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
LOGIN_RATE_LIMIT=100

# --- Email notifications (optional in development) ---
# If SMTP_HOST is blank, messages are logged and recorded as "logged" instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GarageBookLK <no-reply@garagebook.lk>"

# --- Reminders ---
REMINDERS_ENABLED=true
REMINDER_HOURS=24
REMINDER_INTERVAL_MINUTES=30
# Hours after an appointment before a customer can confirm it themselves.
SERVICE_CONFIRM_GRACE_HOURS=24

# Customers must review a completed booking before they can make another.
# Set to false to switch the rule off.
REVIEW_REQUIRED=true

# --- Payments: no real money is ever processed ---
# simulated = built-in test screen. payhere = PayHere sandbox.
PAYMENT_PROVIDER=simulated
DEPOSIT_PERCENT=20
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
# Must be reachable from the internet for PayHere's notification to arrive.
PUBLIC_API_URL=http://localhost:8081

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

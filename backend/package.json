{
  "name": "garagebooklk-backend",
  "version": "1.0.0",
  "description": "Centralized garage booking platform — REST API (Node.js + Express + MySQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node src/db/reset.js --yes",
    "seed": "node src/db/seed.js",
    "db:fresh": "npm run db:reset && npm run seed",
    "reminders": "node scripts/sendReminders.js",
    "test": "node --test --test-concurrency=1 tests/timeSlots.test.js tests/payments.test.js tests/api.test.js tests/features.test.js tests/concurrency-advanced.test.js tests/concurrency.test.js",
    "test:unit": "node --test tests/timeSlots.test.js tests/payments.test.js",
    "test:api": "node --test --test-concurrency=1 tests/api.test.js tests/features.test.js",
    "test:concurrency": "node --test --test-concurrency=1 tests/concurrency-advanced.test.js tests/concurrency.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "axios": "^1.7.7"
  }
}
